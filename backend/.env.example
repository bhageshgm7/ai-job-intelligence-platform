# Django Settings
SECRET_KEY=django-insecure-ai-job-intelligence-platform-change-me-in-production-1234567890
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL by default, auto-falls back to SQLite if unreachable)
# To use PostgreSQL, ensure PostgreSQL service is running and database exists
DB_ENGINE=postgresql
DATABASE_NAME=job_intelligence_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ollama AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
